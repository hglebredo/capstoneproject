# ===================================================================
# .dockerignore - Archivos locales que NO se copian al contenedor
# ===================================================================

# Entornos virtuales
.venv/
venv/
env/
ENV/

# Caché de Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.hypothesis/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore
.gitattributes

# Archivos de entorno y secretos (Render copia los Secret Files al contexto del build)
.env
gemini_api_key
!.dockerignore

# Datos locales pesados
# data/ SÍ entra en la imagen: el corpus es necesario para construir el índice del RAG.
# output/ no: el índice se genera dentro de la imagen, no se copia del portátil.
output/
storage/
uploads/
.chroma_db/

# Documentación local
docs/_build/
*.md.bak

# Scripts temporales
tempCodeRunnerFile.py
.tmp/

# Logs y coverage
*.log
.coverage*
htmlcov/

# Front: es un cliente local, no va en la imagen de la API
front/

# Bases de datos locales (el historial vive en PostgreSQL)
*.db
*.sqlite3

# Render / Deploy (no copiar configuración del host)
render.yaml
Dockerfile.*.bak
