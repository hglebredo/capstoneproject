# ===================================================================
# RAG -  Variables de entorno para Project Break 3 (MLOps)
# Copiar a .env y ajustar valores. NUNCA commitear .env.
# ===================================================================

#### SUPERVISOR Y GRAFO ####
MAX_ITER=8
SUPERVISOR_MODE=reglas
SUPERVISOR_PROVIDER=
SUPERVISOR_MODEL=
SUPERVISOR_TEMPERATURE=0
SUPERVISOR_MAX_OUTPUT_TOKENS=256
SUPERVISOR_TIMEOUT=30
RAG_CALLABLE=
MAX_STEPS=4
MAX_TURNS=
HTTP_TIMEOUT=

#### RAG -  Proveedores ####
EMBED_PROVIDER=google      # ollama | huggingface | google (ollama por defecto si no hay clave)
TAG_PROVIDER=google
GEN_PROVIDER=google        # debe ser "google" para PB3/MLOps (Gemini único proveedor)

# --- Imágenes / OCR / multimodal ---
IMAGE_OCR_ENABLED=true
IMAGE_VISION_ENABLED=false
IMAGE_VISION_MODEL=
IMAGE_OCR_LANG=spa+eng
IMAGE_MAX_DESCRIPTION_CHARS=1200

RAG_RETRIEVAL_MODE=hibrido   # "vectorial" | "hibrido"

GOOGLE_API_KEY=""            # Clave de Gemini (la que lee el código del PB2)
HF_TOKEN=""             # Token de HuggingFace (opcional, si se usa HF) 


# --- Google (online) -  Gemini para generación y embeddings ---
GOOGLE_EMBED_MODEL=gemini-embedding-2
GOOGLE_TAG_MODEL=gemini-3.6-flash
GOOGLE_GEN_MODEL=gemini-3.6-flash

# --- Ollama (offline, opcional) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TAG_MODEL=smtek/Qwen3.8-27B:Q2_K_XL-16gb
OLLAMA_GEN_MODEL=smtek/Qwen3.8-27B:Q2_K_XL-16gb

# --- HuggingFace (online, opcional) ---
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_TAG_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_GEN_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_DEVICE=cuda

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=5
MAX_CHUNKS=5

# --- Embeddings ---
EMBED_DIM=1024
EMBED_BATCH_SIZE=50
EXPORT_EMBEDDINGS=true
EMBED_CHECKPOINT_ENABLED=true
EMBED_DIM_MAX_OLLAMA=1024
EMBED_DIM_MAX_HF=
EMBED_DIM_MAX_GOOGLE=

# --- TSD: tagging + scoring + dedup ---
TAG_SCORING_DEDUP=true
DEDUP_UMBRAL=0.93
DEDUP_AUDIT=true
DEDUP_AUDIT_RUTA=output/dedup_audit.jsonl

# --- Eval set ---
EVAL_SET=true
EVAL_SET_N=50
EVAL_SET_RUTA=queries/eval_set.jsonl
GEN_TIMEOUT=240

# --- ChromaDB (fallback local) ---
CHROMA_DIR=./output/chromadb
COLLECTION_NAME=deporte_municipal

# --- Question set ---
QUESTION_SET=true
MAX_QUESTIONS=2
QUESTION_SET_RUTA=./output/question_set.json

# --- OCR para PDF ---
TESSERACT_CMD=
POPPLER_PATH=
OCR_LANG=spa
OCR_DPI=200

# ===================================================================
#### PB3 / MLOps -  Variables de la API REST ####
# ===================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deportes
API_KEY=cambia-esto            # Clave de la API (la demo se envía al profesorado aparte)
CORS_ORIGINS=*                 # Orígenes permitidos para el front Streamlit
ASK_TIMEOUT_SECONDS=300        # Timeout de un turno en segundos
RATE_LIMIT_PER_MINUTE=60       # Peticiones máximas por IP

# --- Proveedor único: Gemini (sin Ollama ni HuggingFace en producción) ---
GEN_PROVIDER=google            # Debe ser google para PB3/MLOps
EMBED_PROVIDER=google          # Debe ser google para PB3/MLOps
TAG_PROVIDER=google            # Hereda de GEN por defecto

# --- Entorno portable ---
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
